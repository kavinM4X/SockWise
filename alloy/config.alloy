discovery.docker "sockwise_containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "sockwise_logs" {
  targets = discovery.docker.sockwise_containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(sockwise-.+)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["container"]
    regex         = "sockwise-(.*)"
    target_label  = "service"
  }

  rule {
    target_label = "environment"
    replacement  = "local"
  }
}

loki.source.docker "sockwise_docker_source" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.sockwise_logs.output
  forward_to = [loki.write.loki_endpoint.receiver]
}

loki.write "loki_endpoint" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
