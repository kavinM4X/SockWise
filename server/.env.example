# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas URI)
MONGO_URI=
MONGODB_URI=

# Authentication
JWT_SECRET=

# Frontend URLs for CORS
FRONTEND_URL=
CLIENT_URL=

# Observability (OpenTelemetry / Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_SERVICE_NAME=sockwise-backend

# Health Check / Monitoring
HEALTH_KEY=
HEALTH_CRON_EXPRESSION=0 */4 * * *
