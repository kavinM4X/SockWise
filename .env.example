# Backend Environment Variables
PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sockwise?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production
FRONTEND_URL=https://sockwise.vercel.app

# Frontend Environment Variables (Build Time)
# VITE_API_URL is optional if serving from same origin or using proxy
VITE_API_URL=https://your-backend-api.com/api
