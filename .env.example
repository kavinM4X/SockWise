# GHCR Container Deployment Tag (optional, defaults to sha-c55ceef or latest)
IMAGE_TAG=latest

# Backend Environment Variables
PORT=5000
NODE_ENV=production
MONGO_URI=
MONGODB_URI=
JWT_SECRET=
FRONTEND_URL=
CLIENT_URL=
HEALTH_KEY=
HEALTH_CRON_EXPRESSION=0 */4 * * *
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_SERVICE_NAME=sockwise-backend

# Frontend Environment Variables (Build Time)
VITE_API_URL=/api
